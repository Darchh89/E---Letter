<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FAFAFA"
    tools:context=".halaman_panduan_guru">

    <!-- HEADER / APP BAR -->
    <LinearLayout
        android:id="@+id/header_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="20dp"
        android:paddingVertical="16dp"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Ganti dengan icon logo sekolah Anda -->
        <ImageView
            android:id="@+id/icon_logo"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/logo_smk"
            app:tint="#424242" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:text="Panduan"
            android:textColor="#3FA2F6"
            android:textSize="18sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/btn_notifikasi"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/logo_notifikasi"
            app:tint="#6B7280" />
    </LinearLayout>

    <View
        android:id="@+id/header_shadow"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#E5E7EB"
        app:layout_constraintTop_toBottomOf="@id/header_layout" />

    <!-- KONTEN UTAMA (SCROLLABLE) -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingBottom="24dp"
        android:scrollbars="none"
        app:layout_constraintBottom_toTopOf="@+id/bottom_nav"
        app:layout_constraintTop_toBottomOf="@+id/header_shadow">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingTop="20dp">

            <!-- BANNER BIRU PUSAT PANDUAN -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="#41A3EE"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clipChildren="true">

                    <!-- Hiasan Lingkaran di Banner -->
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="140dp"
                        android:layout_height="140dp"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:layout_marginEnd="-30dp"
                        android:layout_marginBottom="-30dp"
                        app:cardBackgroundColor="#26FFFFFF"
                        app:cardCornerRadius="70dp"
                        app:cardElevation="0dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Pusat Panduan"
                            android:textColor="@color/white"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="Pelajari cara mudah mengelola perizinan\nsekolah anda secara digital."
                            android:textColor="#E0F2FE"
                            android:textSize="13sp"
                            android:lineSpacingExtra="4dp" />
                    </LinearLayout>
                </RelativeLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- BANNER PERINGATAN (BIRU MUDA) -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                app:cardBackgroundColor="#F0F8FF"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <!-- Garis Penanda Kiri -->
                    <View
                        android:layout_width="4dp"
                        android:layout_height="match_parent"
                        android:background="#1D4ED8" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="6dp"
                            android:text="Perhatian batas waktu persetujuan"
                            android:textColor="#1D4ED8"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <ImageView
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                android:layout_marginTop="2dp"
                                android:src="@drawable/icon_tanda_seru"
                                app:tint="#1D4ED8" />

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:layout_weight="1"
                                android:text="Persetujuan atau penolakan surat izin keluar harus dilakukan maksimal 30 menit setelah notifikasi masuk. Jika melewati batas waktu, Kepala Program atau Wali Kelas berhak mengambil alih aksi."
                                android:textColor="#1E3A8A"
                                android:textSize="11sp"
                                android:lineSpacingExtra="2dp"/>
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ============================================== -->
            <!-- BAGIAN 1: PANDUAN MEMBUAT SURAT                -->
            <!-- ============================================== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:layout_marginBottom="12dp"
                android:orientation="horizontal">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    app:cardBackgroundColor="#93C5FD"
                    app:cardCornerRadius="8dp"
                    app:cardElevation="0dp">
                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_gravity="center"
                        android:src="@drawable/icon_panduan_surat"
                        app:tint="@color/white"/>
                </com.google.android.material.card.MaterialCardView>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:text="Panduan Membuat Surat"
                    android:textColor="#374151"
                    android:textSize="16sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="20dp"
                        android:text="Ikuti langkah-langkah berikut untuk\nmengajukan surat dispensasi kegiatan."
                        android:textColor="#6B7280"
                        android:textSize="13sp"
                        android:lineSpacingExtra="4dp"/>

                    <!-- STEP 1 -->
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                        <LinearLayout android:layout_width="28dp" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center_horizontal" android:layout_marginEnd="12dp">
                            <com.google.android.material.card.MaterialCardView android:layout_width="28dp" android:layout_height="28dp" app:cardCornerRadius="14dp" app:cardBackgroundColor="#7DB4EB" app:cardElevation="0dp">
                                <TextView android:layout_width="match_parent" android:layout_height="match_parent" android:text="1" android:textColor="@color/white" android:textSize="14sp" android:textStyle="bold" android:gravity="center"/>
                            </com.google.android.material.card.MaterialCardView>
                            <View android:layout_width="2dp" android:layout_height="0dp" android:layout_weight="1" android:background="#DBEAFE" android:layout_marginTop="4dp" android:layout_marginBottom="4dp"/>
                        </LinearLayout>
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:paddingBottom="20dp">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Hubungi Guru atau Pembina" android:textColor="#2563EB" android:textStyle="bold" android:textSize="14sp" />
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Hubungi guru atau pembina ekstrakurikuler yang berkaitan dengan kegiatan tersebut." android:textColor="#6B7280" android:textSize="12sp" android:lineSpacingExtra="2dp"/>
                        </LinearLayout>
                    </LinearLayout>

                    <!-- STEP 2 -->
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                        <LinearLayout android:layout_width="28dp" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center_horizontal" android:layout_marginEnd="12dp">
                            <com.google.android.material.card.MaterialCardView android:layout_width="28dp" android:layout_height="28dp" app:cardCornerRadius="14dp" app:cardBackgroundColor="#7DB4EB" app:cardElevation="0dp">
                                <TextView android:layout_width="match_parent" android:layout_height="match_parent" android:text="2" android:textColor="@color/white" android:textSize="14sp" android:textStyle="bold" android:gravity="center"/>
                            </com.google.android.material.card.MaterialCardView>
                            <View android:layout_width="2dp" android:layout_height="0dp" android:layout_weight="1" android:background="#DBEAFE" android:layout_marginTop="4dp" android:layout_marginBottom="4dp"/>
                        </LinearLayout>
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:paddingBottom="20dp">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Sampaikan Keperluannya" android:textColor="#2563EB" android:textStyle="bold" android:textSize="14sp" />
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Jelaskan alasan dispensasi, tanggal kegiatan, waktu izin, serta daftar siswa yang mengikuti." android:textColor="#6B7280" android:textSize="12sp" android:lineSpacingExtra="2dp"/>
                        </LinearLayout>
                    </LinearLayout>

                    <!-- STEP 3 -->
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                        <LinearLayout android:layout_width="28dp" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center_horizontal" android:layout_marginEnd="12dp">
                            <com.google.android.material.card.MaterialCardView android:layout_width="28dp" android:layout_height="28dp" app:cardCornerRadius="14dp" app:cardBackgroundColor="#7DB4EB" app:cardElevation="0dp">
                                <TextView android:layout_width="match_parent" android:layout_height="match_parent" android:text="3" android:textColor="@color/white" android:textSize="14sp" android:textStyle="bold" android:gravity="center"/>
                            </com.google.android.material.card.MaterialCardView>
                            <View android:layout_width="2dp" android:layout_height="0dp" android:layout_weight="1" android:background="#DBEAFE" android:layout_marginTop="4dp" android:layout_marginBottom="4dp"/>
                        </LinearLayout>
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:paddingBottom="20dp">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Tunggu Surat yang Dibuat" android:textColor="#2563EB" android:textStyle="bold" android:textSize="14sp" />
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Guru atau pembina akan membuatkan surat dispensasi melalui aplikasi." android:textColor="#6B7280" android:textSize="12sp" android:lineSpacingExtra="2dp"/>
                        </LinearLayout>
                    </LinearLayout>

                    <!-- STEP 4 -->
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                        <LinearLayout android:layout_width="28dp" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center_horizontal" android:layout_marginEnd="12dp">
                            <com.google.android.material.card.MaterialCardView android:layout_width="28dp" android:layout_height="28dp" app:cardCornerRadius="14dp" app:cardBackgroundColor="#7DB4EB" app:cardElevation="0dp">
                                <TextView android:layout_width="match_parent" android:layout_height="match_parent" android:text="4" android:textColor="@color/white" android:textSize="14sp" android:textStyle="bold" android:gravity="center"/>
                            </com.google.android.material.card.MaterialCardView>
                            <!-- Line dihilangkan pada step terakhir -->
                        </LinearLayout>
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Terima Surat" android:textColor="#2563EB" android:textStyle="bold" android:textSize="14sp" />
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Setelah selesai, siswa dapat melihat surat lalu menunjukkannya kepada guru terkait." android:textColor="#6B7280" android:textSize="12sp" android:lineSpacingExtra="2dp"/>
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ============================================== -->
            <!-- BAGIAN 2: PERSETUJUAN SURAT IZIN               -->
            <!-- ============================================== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:layout_marginBottom="12dp"
                android:orientation="horizontal">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    app:cardBackgroundColor="#93C5FD"
                    app:cardCornerRadius="8dp"
                    app:cardElevation="0dp">
                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_gravity="center"
                        android:src="@drawable/icon_persetujuan"
                        app:tint="@color/white"/>
                </com.google.android.material.card.MaterialCardView>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:text="Persetujuan Surat Izin"
                    android:textColor="#374151"
                    android:textSize="16sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <!-- STEP 1 -->
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                        <LinearLayout android:layout_width="28dp" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center_horizontal" android:layout_marginEnd="12dp">
                            <com.google.android.material.card.MaterialCardView android:layout_width="28dp" android:layout_height="28dp" app:cardCornerRadius="14dp" app:cardBackgroundColor="#7DB4EB" app:cardElevation="0dp">
                                <TextView android:layout_width="match_parent" android:layout_height="match_parent" android:text="1" android:textColor="@color/white" android:textSize="14sp" android:textStyle="bold" android:gravity="center"/>
                            </com.google.android.material.card.MaterialCardView>
                            <View android:layout_width="2dp" android:layout_height="0dp" android:layout_weight="1" android:background="#DBEAFE" android:layout_marginTop="4dp" android:layout_marginBottom="4dp"/>
                        </LinearLayout>
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:paddingBottom="20dp">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Terima Notifikasi" android:textColor="#2563EB" android:textStyle="bold" android:textSize="14sp" />
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Sistem mengirimkan notifikasi saat siswa mengajukan surat izin yang membutuhkan persetujuan anda." android:textColor="#6B7280" android:textSize="12sp" android:lineSpacingExtra="2dp"/>
                        </LinearLayout>
                    </LinearLayout>

                    <!-- STEP 2 -->
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                        <LinearLayout android:layout_width="28dp" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center_horizontal" android:layout_marginEnd="12dp">
                            <com.google.android.material.card.MaterialCardView android:layout_width="28dp" android:layout_height="28dp" app:cardCornerRadius="14dp" app:cardBackgroundColor="#7DB4EB" app:cardElevation="0dp">
                                <TextView android:layout_width="match_parent" android:layout_height="match_parent" android:text="2" android:textColor="@color/white" android:textSize="14sp" android:textStyle="bold" android:gravity="center"/>
                            </com.google.android.material.card.MaterialCardView>
                            <View android:layout_width="2dp" android:layout_height="0dp" android:layout_weight="1" android:background="#DBEAFE" android:layout_marginTop="4dp" android:layout_marginBottom="4dp"/>
                        </LinearLayout>
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:paddingBottom="20dp">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Periksa Pengajuan" android:textColor="#2563EB" android:textStyle="bold" android:textSize="14sp" />
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Periksa detail pengajuan, cek alasan, waktu keluar, dan identitas siswa." android:textColor="#6B7280" android:textSize="12sp" android:lineSpacingExtra="2dp"/>
                        </LinearLayout>
                    </LinearLayout>

                    <!-- STEP 3 -->
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                        <LinearLayout android:layout_width="28dp" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center_horizontal" android:layout_marginEnd="12dp">
                            <com.google.android.material.card.MaterialCardView android:layout_width="28dp" android:layout_height="28dp" app:cardCornerRadius="14dp" app:cardBackgroundColor="#7DB4EB" app:cardElevation="0dp">
                                <TextView android:layout_width="match_parent" android:layout_height="match_parent" android:text="3" android:textColor="@color/white" android:textSize="14sp" android:textStyle="bold" android:gravity="center"/>
                            </com.google.android.material.card.MaterialCardView>
                            <View android:layout_width="2dp" android:layout_height="0dp" android:layout_weight="1" android:background="#DBEAFE" android:layout_marginTop="4dp" android:layout_marginBottom="4dp"/>
                        </LinearLayout>
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:paddingBottom="20dp">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Setujui atau Tolak" android:textColor="#2563EB" android:textStyle="bold" android:textSize="14sp" />
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Berikan keputusan jika ditolak, serta alasan agar siswa dapat merespon." android:textColor="#6B7280" android:textSize="12sp" android:lineSpacingExtra="2dp"/>
                        </LinearLayout>
                    </LinearLayout>

                    <!-- STEP 4 -->
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                        <LinearLayout android:layout_width="28dp" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center_horizontal" android:layout_marginEnd="12dp">
                            <com.google.android.material.card.MaterialCardView android:layout_width="28dp" android:layout_height="28dp" app:cardCornerRadius="14dp" app:cardBackgroundColor="#7DB4EB" app:cardElevation="0dp">
                                <TextView android:layout_width="match_parent" android:layout_height="match_parent" android:text="4" android:textColor="@color/white" android:textSize="14sp" android:textStyle="bold" android:gravity="center"/>
                            </com.google.android.material.card.MaterialCardView>
                        </LinearLayout>
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Surat Diteruskan" android:textColor="#2563EB" android:textStyle="bold" android:textSize="14sp" />
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Jika disetujui, sistem meneruskan ke guru piket atau proses akhir." android:textColor="#6B7280" android:textSize="12sp" android:lineSpacingExtra="2dp"/>
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </ScrollView>

    <!-- BOTTOM NAVIGATION (CUSTOM) -->
    <LinearLayout
        android:id="@+id/bottom_nav"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:background="@color/white"
        android:elevation="16dp"
        android:gravity="center"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent">

        <!-- Beranda -->
        <LinearLayout
            android:id="@+id/nav_beranda"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">
            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/icon_beranda_new"
                app:tint="#9CA3AF" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Beranda"
                android:textColor="#9CA3AF"
                android:textSize="10sp" />
        </LinearLayout>

        <!-- Riwayat -->
        <LinearLayout
            android:id="@+id/nav_riwayat"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">
            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/icon_riwayat_new"
                app:tint="#9CA3AF" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Riwayat"
                android:textColor="#9CA3AF"
                android:textSize="10sp" />
        </LinearLayout>

        <!-- Panduan (Active) -->
        <LinearLayout
            android:id="@+id/nav_panduan"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">
            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/icon_panduan_biru_new"
                app:tint="#3FA2F6" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Panduan"
                android:textColor="#3FA2F6"
                android:textStyle="bold"
                android:textSize="10sp" />
        </LinearLayout>

        <!-- Profil -->
        <LinearLayout
            android:id="@+id/nav_profil"
            android:layout_width="0dp"
