<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8FAFF">

    <LinearLayout
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp"
        android:gravity="center_vertical"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <ImageView
            android:id="@+id/tombol_back"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/tombol_back"
            app:tint="#4DA8DA" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="Edit Profil"
            android:textColor="#4DA8DA"
            android:textSize="18sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toBottomOf="@id/header"
        app:layout_bottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="horizontal"
                android:layout_marginBottom="32dp">
                <TextView
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:background="@drawable/bg_circle_blue"
                    android:text="1"
                    android:textColor="@android:color/white"
                    android:gravity="center"
                    android:textStyle="bold"/>
                <View android:layout_width="60dp" android:layout_height="1dp" android:background="#E0E0E0" android:layout_marginHorizontal="8dp"/>
                <TextView
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:background="@drawable/bg_circle_gray"
                    android:text="2"
                    android:textColor="#999999"
                    android:gravity="center"/>
                <View android:layout_width="60dp" android:layout_height="1dp" android:background="#E0E0E0" android:layout_marginHorizontal="8dp"/>
                <TextView
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:background="@drawable/bg_circle_gray"
                    android:text="3"
                    android:textColor="#999999"
                    android:gravity="center"/>
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Lengkapi Profil Anda"
                android:textColor="#333333"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginBottom="20dp"/>

            <TextView android:text="Nama" android:textStyle="bold" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginBottom="8dp"/>
            <EditText android:layout_width="match_parent" android:layout_height="54dp" android:background="@drawable/bg_input_field" android:paddingHorizontal="16dp" android:text="Kue Tambang, S.Pd" android:layout_marginBottom="16dp" android:textSize="14sp"/>

            <TextView android:text="NIP" android:textStyle="bold" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginBottom="8dp"/>
            <EditText android:layout_width="match_parent" android:layout_height="54dp" android:background="@drawable/bg_input_field" android:paddingHorizontal="16dp" android:text="198804122010071003" android:layout_marginBottom="16dp" android:textSize="14sp"/>

            <TextView android:text="Email" android:textStyle="bold" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginBottom="8dp"/>
            <EditText android:layout_width="match_parent" android:layout_height="54dp" android:background="@drawable/bg_input_field" android:paddingHorizontal="16dp" android:text="tambang@gmail.com" android:layout_marginBottom="16dp" android:textSize="14sp"/>

            <TextView android:text="Nomor Telepon" android:textStyle="bold" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginBottom="8dp"/>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:background="@drawable/bg_input_field"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="16dp"
                android:layout_marginBottom="16dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="+62" android:textStyle="bold" android:textColor="#333333"/>
                <EditText android:layout_width="match_parent" android:layout_height="match_parent" android:background="@android:color/transparent" android:text="81234567890" android:paddingStart="8dp" android:textSize="14sp"/>
            </LinearLayout>

            <TextView android:text="Peran Tambahan" android:textStyle="bold" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginBottom="8dp"/>
            <GridLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:columnCount="2"
                android:layout_marginBottom="16dp">

                <CheckBox android:layout_width="0dp" android:layout_columnWeight="1" android:text="Kepala Program" android:checked="true" android:background="@drawable/bg_role_selected" android:layout_margin="4dp" android:padding="12dp" android:button="@null" android:drawableEnd="?android:attr/listChoiceIndicatorMultiple"/>
                <CheckBox android:layout_width="0dp" android:layout_columnWeight="1" android:text="Guru Mapel" android:layout_margin="4dp" android:padding="12dp" android:background="@drawable/bg_input_field" android:button="@null" android:drawableEnd="?android:attr/listChoiceIndicatorMultiple"/>
                <CheckBox android:layout_width="0dp" android:layout_columnWeight="1" android:text="Wali Kelas" android:checked="true" android:background="@drawable/bg_role_selected" android:layout_margin="4dp" android:padding="12dp" android:button="@null" android:drawableEnd="?android:attr/listChoiceIndicatorMultiple"/>
                <CheckBox android:layout_width="0dp" android:layout_columnWeight="1" android:text="Tatib" android:layout_margin="4dp" android:padding="12dp" android:background="@drawable/bg_input_field" android:button="@null" android:drawableEnd="?android:attr/listChoiceIndicatorMultiple"/>
            </GridLayout>

            <TextView android:text="Wali Kelas Dari" android:textStyle="bold" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginBottom="8dp"/>
            <Spinner android:layout_width="match_parent" android:layout_height="54dp" android:background="@drawable/bg_input_field" android:layout_marginBottom="16dp"/>

            <TextView android:text="Kepala Program" android:textStyle="bold" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginBottom="8dp"/>
            <Spinner android:layout_width="match_parent" android:layout_height="54dp" android:background="@drawable/bg_input_field" android:layout_marginBottom="32dp"/>

            <Button
                android:id="@+id/btn_lanjut"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="Lanjut ke Tanda Tangan"
                android:textAllCaps="false"
                android:backgroundTint="#4DA8DA"
                app:cornerRadius="12dp"
                android:drawableEnd="@drawable/icon_panah_kanan"
                android:paddingEnd="16dp"/>
        </LinearLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>