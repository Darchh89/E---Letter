<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FAFAFA"
    tools:context=".halaman_panduan_siswa">

    <LinearLayout
        android:id="@+id/header_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="24dp"
        android:paddingVertical="16dp"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/logo_smk" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:text="Panduan"
            android:textColor="#3FA2F6"
            android:textSize="18sp"
            android:textStyle="bold" />

        <ImageView
            android:layout_width="24dp"
            android:layout_height="wrap_content"
            android:src="@drawable/logo_notifikasi"
            app:tint="#6B7280" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingBottom="24dp"
        android:scrollbars="none"
        app:layout_constraintBottom_toTopOf="@+id/bottom_nav"
        app:layout_constraintTop_toBottomOf="@+id/header_layout">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="24dp"
            android:paddingTop="24dp">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="140dp"
                android:layout_marginBottom="24dp"
                app:cardBackgroundColor="#4AA8F8"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clipChildren="true">

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="160dp"
                        android:layout_height="160dp"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:layout_marginEnd="-40dp"
                        android:layout_marginBottom="-40dp"
                        app:cardBackgroundColor="#26FFFFFF"
                        app:cardCornerRadius="80dp"
                        app:cardElevation="0dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:padding="20dp"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Pusat Panduan"
                            android:textColor="@color/white"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="Pelajari cara mudah mengelola perizinan\nsekolah anda secara digital."
                            android:textColor="#E0F2FE"
                            android:textSize="13sp"
                            android:lineSpacingExtra="4dp" />
                    </LinearLayout>
                </RelativeLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Panduan Membuat Surat"
                android:textColor="#1F2937"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:layout_marginBottom="16dp"
                android:text="Cara mudah membuat surat izin dengan benar"
                android:textColor="#6B7280"
                android:textSize="12sp" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="12dp"
                app:cardElevation="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="4dp">

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/header_dispensasi"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        app:cardCornerRadius="10dp"
                        app:cardElevation="0dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@drawable/bg_gradient_biru"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingHorizontal="16dp">

                            <com.google.android.material.card.MaterialCardView
                                android:layout_width="32dp"
                                android:layout_height="32dp"
                                app:cardBackgroundColor="@color/white"
                                app:cardCornerRadius="16dp"
                                app:cardElevation="0dp">
                                <ImageView
                                    android:layout_width="16dp"
                                    android:layout_height="16dp"
                                    android:layout_gravity="center"
                                    android:src="@drawable/icon_surat_dispensasi"
                                    app:tint="#4AA8F8" />
                            </com.google.android.material.card.MaterialCardView>

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="12dp"
                                android:layout_weight="1"
                                android:text="Surat Dispensasi"
                                android:textColor="@color/white"
                                android:textSize="15sp"
                                android:textStyle="bold" />

                            <ImageView
                                android:id="@+id/arrow_dispensasi"
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:rotation="180"
                                android:src="@drawable/icon_panah_atas_putih" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/content_dispensasi"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:visibility="gone"
                        app:cardBackgroundColor="@color/white"
                        app:cardElevation="0dp"
                        app:strokeColor="#4AA8F8"
                        app:strokeWidth="1dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="20dp">

                            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                                <LinearLayout android:layout_width="28dp" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center_horizontal" android:layout_marginEnd="12dp">
                                    <com.google.android.material.card.MaterialCardView android:layout_width="28dp" android:layout_height="28dp" app:cardCornerRadius="14dp" app:cardBackgroundColor="#7DB4EB" app:cardElevation="0dp">
                                        <TextView android:layout_width="match_parent" android:layout_height="match_parent" android:text="1" android:textColor="@color/white" android:textSize="14sp" android:textStyle="bold" android:gravity="center"/>
                                    </com.google.android.material.card.MaterialCardView>
                                    <View android:layout_width="1dp" android:layout_height="0dp" android:layout_weight="1" android:background="#DBEAFE" android:layout_marginTop="4dp" android:layout_marginBottom="4dp"/>
                                </LinearLayout>
                                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:paddingBottom="20dp">
                                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Hubungi Guru atau Pembina" android:textColor="#2563EB" android:textStyle="bold" android:textSize="14sp" />
                                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Hubungi guru atau pembina ekstrakurikuler yang berkaitan dengan kegiatan tersebut." android:textColor="#6B7280" android:textSize="12sp" android:lineSpacingExtra="2dp"/>
                                </LinearLayout>
                            </LinearLayout>

                            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                                <LinearLayout android:layout_width="28dp" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center_horizontal" android:layout_marginEnd="12dp">
                                    <com.google.android.material.card.MaterialCardView android:layout_width="28dp" android:layout_height="28dp" app:cardCornerRadius="14dp" app:cardBackgroundColor="#7DB4EB" app:cardElevation="0dp">
                                        <TextView android:layout_width="match_parent" android:layout_height="match_parent" android:text="2" android:textColor="@color/white" android:textSize="14sp" android:textStyle="bold" android:gravity="center"/>
                                    </com.google.android.material.card.MaterialCardView>
                                    <View android:layout_width="1dp" android:layout_height="0dp" android:layout_weight="1" android:background="#DBEAFE" android:layout_marginTop="4dp" android:layout_marginBottom="4dp"/>
                                </LinearLayout>
                                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:paddingBottom="20dp">
                                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Sampaikan Keperluannya" android:textColor="#2563EB" android:textStyle="bold" android:textSize="14sp" />
                                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Jelaskan alasan dispensasi, tanggal kegiatan, waktu izin, serta daftar siswa yang mengikuti." android:textColor="#6B7280" android:textSize="12sp" android:lineSpacingExtra="2dp"/>
                                </LinearLayout>
                            </LinearLayout>

                            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                                <LinearLayout android:layout_width="28dp" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center_horizontal" android:layout_marginEnd="12dp">
                                    <com.google.android.material.card.MaterialCardView android:layout_width="28dp" android:layout_height="28dp" app:cardCornerRadius="14dp" app:cardBackgroundColor="#7DB4EB" app:cardElevation="0dp">
                                        <TextView android:layout_width="match_parent" android:layout_height="match_parent" android:text="3" android:textColor="@color/white" android:textSize="14sp" android:textStyle="bold" android:gravity="center"/>
                                    </com.google.android.material.card.MaterialCardView>
                                    <View android:layout_width="1dp" android:layout_height="0dp" android:layout_weight="1" android:background="#DBEAFE" android:layout_marginTop="4dp" android:layout_marginBottom="4dp"/>
                                </LinearLayout>
                                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:paddingBottom="20dp">
                                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Tunggu Surat yang Dibuat" android:textColor="#2563EB" android:textStyle="bold" android:textSize="14sp" />
                                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Guru atau pembina akan membuatkan surat dispensasi melalui aplikasi." android:textColor="#6B7280" android:textSize="12sp" android:lineSpacingExtra="2dp"/>
                                </LinearLayout>
                            </LinearLayout>

                            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                                <LinearLayout android:layout_width="28dp" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center_horizontal" android:layout_marginEnd="12dp">
                                    <com.google.android.material.card.MaterialCardView android:layout_width="28dp" android:layout_height="28dp" app:cardCornerRadius="14dp" app:cardBackgroundColor="#7DB4EB" app:cardElevation="0dp">
                                        <TextView android:layout_width="match_parent" android:layout_height="match_parent" android:text="4" android:textColor="@color/white" android:textSize="14sp" android:textStyle="bold" android:gravity="center"/>
                                    </com.google.android.material.card.MaterialCardView>
                                </LinearLayout>
                                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Terima Surat" android:textColor="#2563EB" android:textStyle="bold" android:textSize="14sp" />
                                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Setelah selesai, siswa dapat melihat surat lalu menunjukkannya kepada guru terkait." android:textColor="#6B7280" android:textSize="12sp" android:lineSpacingExtra="2dp"/>
                                </LinearLayout>
                            </LinearLayout>

                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="12dp"
                app:cardElevation="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="4dp">

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/header_masuk"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        app:cardCornerRadius="10dp"
                        app:cardElevation="0dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@drawable/bg_gradient_ungu"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingHorizontal="16dp">

                            <com.google.android.material.card.MaterialCardView
                                android:layout_width="32dp"
                                android:layout_height="32dp"
                                app:cardBackgroundColor="@color/white"
                                app:cardCornerRadius="16dp"
                                app:cardElevation="0dp">
                                <ImageView
                                    android:layout_width="16dp"
                                    android:layout_height="16dp"
                                    android:layout_gravity="center"
                                    android:src="@drawable/icon_surat_izin_masuk"
                                    app:tint="#A464DF" />
                            </com.google.android.material.card.MaterialCardView>

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="12dp"
                                android:layout_weight="1"
                                android:text="Surat Izin Masuk"
                                android:textColor="@color/white"
                                android:textSize="15sp"
                                android:textStyle="bold" />

                            <ImageView
                                android:id="@+id/arrow_masuk"
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:rotation="180"
                                android:src="@drawable/icon_panah_atas_putih" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/content_masuk"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:visibility="gone"
                        app:cardBackgroundColor="@color/white"
                        app:cardElevation="0dp"
                        app:strokeColor="#A855F7"
                        app:strokeWidth="1dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="20dp">

                            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                                <LinearLayout android:layout_width="28dp" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center_horizontal" android:layout_marginEnd="12dp">
                                    <com.google.android.material.card.MaterialCardView android:layout_width="28dp" android:layout_height="28dp" app:cardCornerRadius="14dp" app:cardBackgroundColor="#C084FC" app:cardElevation="0dp">
                                        <TextView android:layout_width="match_parent" android:layout_height="match_parent" android:text="1" android:textColor="@color/white" android:textSize="14sp" android:textStyle="bold" android:gravity="center"/>
                                    </com.google.android.material.card.MaterialCardView>
                                    <View android:layout_width="1dp" android:layout_height="0dp" android:layout_weight="1" android:background="#F3E8FF" android:layout_marginTop="4dp" android:layout_marginBottom="4dp"/>
                                </LinearLayout>
                                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:paddingBottom="20dp">
                                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Isi Form Surat" android:textColor="#9333EA" android:textStyle="bold" android:textSize="14sp" />
                                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Masukkan nama, kelas, jurusan serta keterangan atau alasan mengapa izin masuk sekolah." android:textColor="#6B7280" android:textSize="12sp" android:lineSpacingExtra="2dp"/>
                                </LinearLayout>
                            </LinearLayout>

                            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                                <LinearLayout android:layout_width="28dp" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center_horizontal" android:layout_marginEnd="12dp">
                                    <com.google.android.material.card.MaterialCardView android:layout_width="28dp" android:layout_height="28dp" app:cardCornerRadius="14dp" app:cardBackgroundColor="#C084FC" app:cardElevation="0dp">
                                        <TextView android:layout_width="match_parent" android:layout_height="match_parent" android:text="2" android:textColor="@color/white" android:textSize="14sp" android:textStyle="bold" android:gravity="center"/>
                                    </com.google.android.material.card.MaterialCardView>
                                    <View android:layout_width="1dp" android:layout_height="0dp" android:layout_weight="1" android:background="#F3E8FF" android:layout_marginTop="4dp" android:layout_marginBottom="4dp"/>
                                </LinearLayout>
                                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:paddingBottom="20dp">
                                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Periksa Kembali Data" android:textColor="#9333EA" android:textStyle="bold" android:textSize="14sp" />
                                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Pastikan semua data yang diisi sudah benar dan sesuai." android:textColor="#6B7280" android:textSize="12sp" android:lineSpacingExtra="2dp"/>
                                </LinearLayout>
                            </LinearLayout>

                            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                                <LinearLayout android:layout_width="28dp" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center_horizontal" android:layout_marginEnd="12dp">
                                    <com.google.android.material.card.MaterialCardView android:layout_width="28dp" android:layout_height="28dp" app:cardCornerRadius="14dp" app:cardBackgroundColor="#C084FC" app:cardElevation="0dp">
                                        <TextView android:layout_width="match_parent" android:layout_height="match_parent" android:text="3" android:textColor="@color/white" android:textSize="14sp" android:textStyle="bold" android:gravity="center"/>
                                    </com.google.android.material.card.MaterialCardView>
                                    <View android:layout_width="1dp" android:layout_height="0dp" android:layout_weight="1" android:background="#F3E8FF" android:layout_marginTop="4dp" android:layout_marginBottom="4dp"/>
                                </LinearLayout>
                                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:paddingBottom="20dp">
                                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Tanda Tangan" android:textColor="#9333EA" android:textStyle="bold" android:textSize="14sp" />
                                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Ajukan dan minta tanda tangan petugas tata tertib (Tatib)." android:textColor="#6B7280" android:textSize="12sp" android:lineSpacingExtra="2dp"/>
                                </LinearLayout>
                            </LinearLayout>

                            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                                <LinearLayout android:layout_width="28dp" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center_horizontal" android:layout_marginEnd="12dp">
                                    <com.google.android.material.card.MaterialCardView android:layout_width="28dp" android:layout_height="28dp" app:cardCornerRadius="14dp" app:cardBackgroundColor="#C084FC" app:cardElevation="0dp">
                                        <TextView android:layout_width="match_parent" android:layout_height="match_parent" android:text="4" android:textColor="@color/white" android:textSize="14sp" android:textStyle="bold" android:gravity="center"/>
                                    </com.google.android.material.card.MaterialCardView>
                                </LinearLayout>
                                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Serahkan Surat" android:textColor="#9333EA" android:textStyle="bold" android:textSize="14sp" />
                                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Perlihatkan hasil surat kepada guru piket atau guru mapel yang bersangkutan sebelum masuk kelas." android:textColor="#6B7280" android:textSize="12sp" android:lineSpacingExtra="2dp"/>
                                </LinearLayout>
                            </LinearLayout>
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>


            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="12dp"
                app:cardElevation="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="4dp">

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/header_keluar"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        app:cardCornerRadius="10dp"
                        app:cardElevation="0dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@drawable/bg_gradient_oren"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingHorizontal="16dp">

                            <com.google.android.material.card.MaterialCardView
                                android:layout_width="32dp"
                                android:layout_height="32dp"
                                app:cardBackgroundColor="@color/white"
                                app:cardCornerRadius="16dp"
                                app:cardElevation="0dp">
                                <ImageView
                                    android:layout_width="16dp"
                                    android:layout_height="16dp"
                                    android:layout_gravity="center"
                                    android:src="@drawable/icon_surat_izin_keluar"
                                    app:tint="#F97316" />
                            </com.google.android.material.card.MaterialCardView>

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="12dp"
                                android:layout_weight="1"
                                android:text="Surat Izin Keluar"
                                android:textColor="@color/white"
                                android:textSize="15sp"
                                android:textStyle="bold" />

                            <ImageView
                                android:id="@+id/arrow_keluar"
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:rotation="180"
                                android:src="@drawable/icon_panah_atas_putih" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/content_keluar"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:visibility="gone"
                        app:cardBackgroundColor="@color/white"
                        app:cardElevation="0dp"
                        app:strokeColor="#F97316"
                        app:strokeWidth="1dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="20dp">

                            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="16dp" android:orientation="horizontal">
                                <LinearLayout android:layout_width="28dp" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center_horizontal" android:layout_marginEnd="12dp">
                                    <com.google.android.material.card.MaterialCardView android:layout_width="28dp" android:layout_height="28dp" app:cardCornerRadius="14dp" app:cardBackgroundColor="#FB923C" app:cardElevation="0dp">
                                        <TextView android:layout_width="match_parent" android:layout_height="match_parent" android:text="1" android:textColor="@color/white" android:textSize="14sp" android:textStyle="bold" android:gravity="center"/>
                                    </com.google.android.material.card.MaterialCardView>
                                    <View android:layout_width="1dp" android:layout_height="0dp" android:layout_weight="1" android:background="#FFEDD5" android:layout_marginTop="4dp" android:layout_marginBottom="4dp"/>
                                </LinearLayout>
                                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:paddingBottom="20dp">
                                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Isi Form Surat" android:textColor="#EA580C" android:textStyle="bold" android:textSize="14sp" />
                                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Masukkan nama, kelas, jurusan serta keterangan atau alasan mengapa izin keluar sekolah." android:textColor="#6B7280" android:textSize="12sp" android:lineSpacingExtra="2dp"/>
                                </LinearLayout>
                            </LinearLayout>

                            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="16dp" android:orientation="horizontal">
                                <LinearLayout android:layout_width="28dp" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center_horizontal" android:layout_marginEnd="12dp">
                                    <com.google.android.material.card.MaterialCardView android:layout_width="28dp" android:layout_height="28dp" app:cardCornerRadius="14dp" app:cardBackgroundColor="#FB923C" app:cardElevation="0dp">
                                        <TextView android:layout_width="match_parent" android:layout_height="match_parent" android:text="2" android:textColor="@color/white" android:textSize="14sp" android:textStyle="bold" android:gravity="center"/>
                                    </com.google.android.material.card.MaterialCardView>
                                    <View android:layout_width="1dp" android:layout_height="0dp" android:layout_weight="1" android:background="#FFEDD5" android:layout_marginTop="4dp" android:layout_marginBottom="4dp"/>
                                </LinearLayout>
                                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:paddingBottom="20dp">
                                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Periksa Kembali Data" android:textColor="#EA580C" android:textStyle="bold" android:textSize="14sp" />
                                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Pastikan alasan yang ditulis jelas dan dapat dipertanggungjawabkan." android:textColor="#6B7280" android:textSize="12sp" android:lineSpacingExtra="2dp"/>
                                </LinearLayout>
                            </LinearLayout>

                            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="16dp" android:orientation="horizontal">
                                <LinearLayout android:layout_width="28dp" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center_horizontal" android:layout_marginEnd="12dp">
                                    <com.google.android.material.card.MaterialCardView android:layout_width="28dp" android:layout_height="28dp" app:cardCornerRadius="14dp" app:cardBackgroundColor="#FB923C" app:cardElevation="0dp">
                                        <TextView android:layout_width="match_parent" android:layout_height="match_parent" android:text="3" android:textColor="@color/white" android:textSize="14sp" android:textStyle="bold" android:gravity="center"/>
                                    </com.google.android.material.card.MaterialCardView>
                                    <View android:layout_width="1dp" android:layout_height="0dp" android:layout_weight="1" android:background="#FFEDD5" android:layout_marginTop="4dp" android:layout_marginBottom="4dp"/>
                                </LinearLayout>
                                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:paddingBottom="20dp">
                                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Tanda Tangan" android:textColor="#EA580C" android:textStyle="bold" android:textSize="14sp" />
                                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Ajukan dan minta tanda tangan petugas tata tertib (Tatib)." android:textColor="#6B7280" android:textSize="12sp" android:lineSpacingExtra="2dp"/>
                                </LinearLayout>
                            </LinearLayout>

                            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                                <LinearLayout android:layout_width="28dp" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center_horizontal" android:layout_marginEnd="12dp">
                                    <com.google.android.material.card.MaterialCardView android:layout_width="28dp" android:layout_height="28dp" app:cardCornerRadius="14dp" app:cardBackgroundColor="#FB923C" app:cardElevation="0dp">
                                        <TextView android:layout_width="match_parent" android:layout_height="match_parent" android:text="4" android:textColor="@color/white" android:textSize="14sp" android:textStyle="bold" android:gravity="center"/>
                                    </com.google.android.material.card.MaterialCardView>
                                </LinearLayout>
                                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Serahkan Surat" android:textColor="#EA580C" android:textStyle="bold" android:textSize="14sp" />
                                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Perlihatkan hasil surat kepada guru piket atau guru mapel yang bersangkutan untuk mendapatkan izin keluar." android:textColor="#6B7280" android:textSize="12sp" android:lineSpacingExtra="2dp"/>
                                </LinearLayout>
                            </LinearLayout>
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </ScrollView>

    <LinearLayout
