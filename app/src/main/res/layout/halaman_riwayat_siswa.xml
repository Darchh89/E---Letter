<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FAFAFA"
    tools:context=".halaman_riwayat_siswa">

    <!-- HEADER -->
    <LinearLayout
        android:id="@+id/header_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="24dp"
        android:paddingVertical="16dp"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@drawable/logo_smk" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:text="Riwayat"
            android:textColor="#3FA2F6"
            android:textSize="20sp"
            android:textStyle="bold" />

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/logo_notifikasi"
            app:tint="#424242" />
    </LinearLayout>

    <!-- KONTEN UTAMA DENGAN SCROLL VIEW -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingBottom="24dp"
        android:scrollbars="none"
        app:layout_constraintBottom_toTopOf="@+id/bottom_nav"
        app:layout_constraintTop_toBottomOf="@+id/header_layout">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="24dp"
            android:paddingTop="24dp">

            <!-- KOTAK BIRU (STATISTIK BULAN INI) -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                app:cardBackgroundColor="#41A3EE"
                app:cardCornerRadius="16dp"
                app:cardElevation="4dp">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clipChildren="true">

                    <!-- Hiasan Lingkaran Transparan di Kanan Bawah -->
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="160dp"
                        android:layout_height="160dp"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:layout_marginEnd="-40dp"
                        android:layout_marginBottom="-40dp"
                        app:cardBackgroundColor="#26FFFFFF"
                        app:cardCornerRadius="80dp"
                        app:cardElevation="0dp" />

                    <!-- Konten Teks & Label -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Total Pengajuan Bulan Ini"
                            android:textColor="#E0F2FE"
                            android:textSize="12sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="12 Izin"
                            android:textColor="@color/white"
                            android:textSize="28sp"
                            android:textStyle="bold" />

                        <!-- Row Status -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:orientation="horizontal">

                            <!-- Pil 1: Disetujui -->
                            <com.google.android.material.card.MaterialCardView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginEnd="8dp"
                                app:cardBackgroundColor="#33FFFFFF"
                                app:cardCornerRadius="12dp"
                                app:cardElevation="0dp">
                                <LinearLayout
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:gravity="center_vertical"
                                    android:orientation="horizontal"
                                    android:paddingHorizontal="10dp"
                                    android:paddingVertical="6dp">
                                    <ImageView
                                        android:layout_width="14dp"
                                        android:layout_height="14dp"
                                        android:src="@drawable/icon_disetujui_riwayat" />
                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginStart="6dp"
                                        android:text="8 Disetujui"
                                        android:textColor="@color/white"
                                        android:textSize="11sp" />
                                </LinearLayout>
                            </com.google.android.material.card.MaterialCardView>

                            <!-- Pil 2: Menunggu -->
                            <com.google.android.material.card.MaterialCardView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                app:cardBackgroundColor="#33FFFFFF"
                                app:cardCornerRadius="12dp"
                                app:cardElevation="0dp">
                                <LinearLayout
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:gravity="center_vertical"
                                    android:orientation="horizontal"
                                    android:paddingHorizontal="10dp"
                                    android:paddingVertical="6dp">
                                    <ImageView
                                        android:layout_width="14dp"
                                        android:layout_height="14dp"
                                        android:src="@drawable/icon_menunggu_riwayat" />
                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginStart="6dp"
                                        android:text="3 Menunggu"
                                        android:textColor="@color/white"
                                        android:textSize="11sp" />
                                </LinearLayout>
                            </com.google.android.material.card.MaterialCardView>

                        </LinearLayout>
                    </LinearLayout>
                </RelativeLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- JUDUL LIST RIWAYAT -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Riwayat Surat Izin"
                android:textColor="@android:color/black"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:layout_marginBottom="16dp"
                android:text="Lacak status dan tinjau semua pengajuan izin Anda."
                android:textColor="#757575"
                android:textSize="12sp" />

            <!-- ITEM 1: DISPENSASI -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:strokeColor="#F0F0F0"
                app:strokeWidth="1dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal" android:padding="16dp">
                    <com.google.android.material.card.MaterialCardView android:layout_width="40dp" android:layout_height="40dp" app:cardBackgroundColor="#E3F2FD" app:cardCornerRadius="12dp" app:cardElevation="0dp">
                        <ImageView android:layout_width="20dp" android:layout_height="20dp" android:layout_gravity="center" android:src="@drawable/icon_surat_dispensasi" app:tint="#2196F3" />
                    </com.google.android.material.card.MaterialCardView>
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:layout_weight="1" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Izin Dispensasi" android:textColor="@android:color/black" android:textSize="14sp" android:textStyle="bold" />
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:gravity="center_vertical" android:orientation="horizontal">
                            <ImageView android:layout_width="12dp" android:layout_height="12dp" android:src="@drawable/tanggal_riwayat" />
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="4dp" android:text="15/10/2023 • Lomba Robotik" android:textColor="#757575" android:textSize="11sp" />
                        </LinearLayout>
                    </LinearLayout>
                    <ImageView android:layout_width="16dp" android:layout_height="16dp" android:src="@drawable/icon_panah_kanan" app:tint="#3FA2F6" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ITEM 2: KELUAR -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:strokeColor="#F0F0F0"
                app:strokeWidth="1dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal" android:padding="16dp">
                    <com.google.android.material.card.MaterialCardView android:layout_width="40dp" android:layout_height="40dp" app:cardBackgroundColor="#FFF3E0" app:cardCornerRadius="12dp" app:cardElevation="0dp">
                        <ImageView android:layout_width="20dp" android:layout_height="20dp" android:layout_gravity="center" android:src="@drawable/icon_surat_izin_keluar" app:tint="#FF9800" />
                    </com.google.android.material.card.MaterialCardView>
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:layout_weight="1" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Izin Keluar" android:textColor="@android:color/black" android:textSize="14sp" android:textStyle="bold" />
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:gravity="center_vertical" android:orientation="horizontal">
                            <ImageView android:layout_width="12dp" android:layout_height="12dp" android:src="@drawable/tanggal_riwayat" />
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="4dp" android:text="18/10/2023 • Keperluan Keluarga" android:textColor="#757575" android:textSize="11sp" />
                        </LinearLayout>
                    </LinearLayout>
                    <ImageView android:layout_width="16dp" android:layout_height="16dp" android:src="@drawable/icon_panah_kanan" app:tint="#3FA2F6" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ITEM 3: MASUK -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:strokeColor="#F0F0F0"
                app:strokeWidth="1dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal" android:padding="16dp">
                    <com.google.android.material.card.MaterialCardView android:layout_width="40dp" android:layout_height="40dp" app:cardBackgroundColor="#F3E5F5" app:cardCornerRadius="12dp" app:cardElevation="0dp">
                        <ImageView android:layout_width="20dp" android:layout_height="20dp" android:layout_gravity="center" android:src="@drawable/icon_surat_izin_masuk" app:tint="#9C27B0" />
                    </com.google.android.material.card.MaterialCardView>
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:layout_weight="1" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Izin Masuk (Telat)" android:textColor="@android:color/black" android:textSize="14sp" android:textStyle="bold" />
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:gravity="center_vertical" android:orientation="horizontal">
                            <ImageView android:layout_width="12dp" android:layout_height="12dp" android:src="@drawable/tanggal_riwayat" />
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="4dp" android:text="12/11/2023 • Ban Bocor" android:textColor="#757575" android:textSize="11sp" />
                        </LinearLayout>
                    </LinearLayout>
                    <ImageView android:layout_width="16dp" android:layout_height="16dp" android:src="@drawable/icon_panah_kanan" app:tint="#3FA2F6" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ITEM 4: DISPENSASI (Dihapus jika terlalu panjang, disertakan untuk ilustrasi Scroll) -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:strokeColor="#F0F0F0"
                app:strokeWidth="1dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal" android:padding="16dp">
                    <com.google.android.material.card.MaterialCardView android:layout_width="40dp" android:layout_height="40dp" app:cardBackgroundColor="#E3F2FD" app:cardCornerRadius="12dp" app:cardElevation="0dp">
                        <ImageView android:layout_width="20dp" android:layout_height="20dp" android:layout_gravity="center" android:src="@drawable/icon_surat_dispensasi" app:tint="#2196F3" />
                    </com.google.android.material.card.MaterialCardView>
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:layout_weight="1" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Izin Dispensasi" android:textColor="@android:color/black" android:textSize="14sp" android:textStyle="bold" />
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:gravity="center_vertical" android:orientation="horizontal">
                            <ImageView android:layout_width="12dp" android:layout_height="12dp" android:src="@drawable/tanggal_riwayat" />
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="4dp" android:text="25/01/2024 • Latihan Paskibra" android:textColor="#757575" android:textSize="11sp" />
                        </LinearLayout>
                    </LinearLayout>
                    <ImageView android:layout_width="16dp" android:layout_height="16dp" android:src="@drawable/icon_panah_kanan" app:tint="#3FA2F6" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </ScrollView>

    <!-- BOTTOM NAVIGATION -->
    <LinearLayout
        android:id="@+id/bottom_nav"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:background="@color/white"
        android:elevation="16dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:baselineAligned="false"
        app:layout_constraintBottom_toBottomOf="parent">

        <!-- Nav Beranda -->
        <LinearLayout
            android:id="@+id/nav_beranda"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">
            <ImageView android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/icon_beranda_new" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:gravity="center" android:layout_marginTop="2dp" android:text="Beranda" android:textColor="#9E9E9E" android:textSize="10sp" />
        </LinearLayout>

        <!-- Nav Riwayat (AKTIF - Biru) -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">
            <!-- Asumsi nama icon aktif riwayat adalah icon_riwayat_biru_new sesuai pola -->
            <ImageView android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/icon_riwayat_biru_new" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:gravity="center" android:layout_marginTop="2dp" android:text="Riwayat" android:textColor="#3FA2F6" android:textSize="10sp" android:textStyle="bold" />
        </LinearLayout>

        <!-- Nav Panduan -->
        <LinearLayout
            android:id="@+id/nav_panduan"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">
            <ImageView android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/icon_panduan_new" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:gravity="center" android:layout_marginTop="2dp" android:text="Panduan" android:textColor="#9E9E9E" android:textSize="10sp" />
        </LinearLayout>

        <!-- Nav Profil -->
        <LinearLayout
            android:id="@+id/nav_profil"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">
            <ImageView android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/icon_profil_new" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:gravity="center" android:layout_marginTop="2dp" android:text="Profil" android:textColor="#9E9E9E" android:textSize="10sp" />
        </LinearLayout>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>